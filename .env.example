# MySQL（SQLAlchemy，驱动 pymysql）
DATABASE_URL=mysql+pymysql://user:your_password@host:3306/security_risk

# Milvus 向量库
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DB_DIR=milvus_db

# 静态资源根目录（FastAPI 挂载 /data）
DATA_DIR=data

# 向量后端（仅 Milvus）
SIA_VECTOR_BACKEND=milvus
MILVUS_CONNECT_TIMEOUT=3

# ── 硅基流动 Embedding（规范/知识库向量检索，Qwen3-0.6B = 1024 维）──
SIA_EMBEDDING_BACKEND=openai
inspection_platform_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SILICONFLOW_EMBED_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_EMBED_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
SILICONFLOW_EMBED_CONCURRENCY=4
SIA_EMBEDDING_DIMENSION=1024

# ── 硅基流动 Chat（意图识别、业务编组、规范抽取等 LLM）──
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_CHAT_BASE_URL=https://api.siliconflow.cn/v1
SIA_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SIA_INSPECTION_WORK_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 平台 HTTP
inspection_platform_HOST=127.0.0.1
inspection_platform_PORT=8001

# 流媒体中台（go2rtc：单路 RTSP 拉流，多协议分发）
# SIA_MEDIA_BACKEND=go2rtc
# SIA_GO2RTC_API=http://127.0.0.1:1984
# SIA_GO2RTC_RTSP=rtsp://127.0.0.1:8554

# RTSP：平台统一主码流 1080p（/101）；勿默认子码流
# SIA_RTSP_PREFER_SUB=0
# FLV 预览档（子码流宫格）：码率/预设
# SIA_RTSP_FLV_PRESET=ultrafast
# SIA_RTSP_FLV_BITRATE=800k
# SIA_RTSP_FLV_BUFSIZE=1600k
# FLV 高清档（事件详情/全屏，主码流）：
# SIA_RTSP_FLV_HD_PRESET=veryfast
# SIA_RTSP_FLV_HD_BITRATE=2500k
# SIA_RTSP_FLV_HD_BUFSIZE=5000k
# SIA_RTSP_FLV_HD_SCALE=1920:-2
# SIA_RTSP_FLV_ENCODER=libx264

# 本地 embedding：cuda（默认）| cpu | auto（仅 sentence_transformer 后端）
SIA_EMBEDDING_DEVICE=cuda

# 规范抽取并发分片数
SIA_SPEC_EXTRACT_WORKERS=4
SIA_OPENAI_EMBED_CONCURRENCY=4
SIA_OPENAI_THREAD_POOL_SIZE=8

# vLLM 本地 embedding（切换 SIA_EMBEDDING_BACKEND=vllm 时启用）
# SIA_VLLM_EMBED_BASE_URL=http://127.0.0.1:8100/v1
# SIA_VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# MySQL（SQLAlchemy，驱动 pymysql）
